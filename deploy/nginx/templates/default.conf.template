# Шаблон конфигурации Nginx. Переменные ${...} подставляются при старте контейнера
# (envsubst из официального образа nginx). Переменные Nginx ($host и т.п.) не трогаются,
# т.к. подставляются только определённые переменные окружения.

upstream api_upstream {
    server api:8000;
    keepalive 16;
}

# Схема (https) от внешнего веб-сервера; если её нет — своя
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    # Перед нами стоит основной веб-сервер VPS (tts-ufa.ru -> 127.0.0.1:HTTP_PORT).
    # Берём реальный IP игрока из его заголовка X-Real-IP (нужно для лимитов входа и банов).
    set_real_ip_from 127.0.0.1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Real-IP;

    client_max_body_size 200m;   # ZIP-патчи из админки
    server_tokens off;

    gzip on;
    gzip_types application/json text/plain text/css application/javascript;

    # --- Файлы контента: неизменяемые, адресуются по SHA-256 ---
    # Range-запросы (докачка после обрыва) Nginx поддерживает автоматически.
    location /content/files/ {
        alias /srv/content-store/files/;
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=31536000, immutable";
        sendfile on;
        tcp_nopush on;
        gzip off;
    }

    # --- WebSocket (чат, этап 8) ---
    location /ws/ {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # уже реальный IP (real_ip выше), подделка исключена
        proxy_read_timeout 3600s;
    }

    # --- API и /health ---
    location / {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # уже реальный IP (real_ip выше), подделка исключена
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 120s;
    }
}
