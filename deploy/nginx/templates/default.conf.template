# Шаблон конфигурации Nginx. Переменные ${...} подставляются при старте контейнера
# (envsubst из официального образа nginx). Переменные Nginx ($host и т.п.) не трогаются,
# т.к. подставляются только определённые переменные окружения.

upstream api_upstream {
    server api:8000;
    keepalive 16;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    client_max_body_size 200m;   # ZIP-патчи из админки
    server_tokens off;

    gzip on;
    gzip_types application/json text/plain text/css application/javascript;

    # --- Файлы контента: неизменяемые, адресуются по SHA-256 ---
    # Range-запросы (докачка после обрыва) Nginx поддерживает автоматически.
    location /content/files/ {
        alias /srv/content-store/files/;
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=31536000, immutable";
        sendfile on;
        tcp_nopush on;
        gzip off;
    }

    # --- WebSocket (чат, этап 8) ---
    location /ws/ {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    # --- API и /health ---
    location / {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
