{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufa.game/schemas/campaign_chapter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "number",
    "title",
    "subtitle",
    "dialogue_start",
    "dialogue_end",
    "stages"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^chapter_[1-5]$"
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "dialogue_start": {
      "type": "string",
      "minLength": 1
    },
    "dialogue_end": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "enemy",
          "enemy_multiplier",
          "reward"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "enemy": {
            "type": "string",
            "minLength": 1
          },
          "enemy_multiplier": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "hero_xp"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0
              },
              "hero_xp": {
                "type": "integer",
                "minimum": 0
              },
              "crystals": {
                "type": "integer",
                "minimum": 0
              },
              "scrolls": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}