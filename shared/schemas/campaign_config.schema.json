{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufa.game/schemas/campaign_config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "afk_cap_seconds",
    "gold_per_hour",
    "hero_xp_per_hour",
    "stage_bonus_percent",
    "quick_seconds",
    "quick_daily_limit"
  ],
  "properties": {
    "afk_cap_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "gold_per_hour": {
      "type": "integer",
      "minimum": 0
    },
    "hero_xp_per_hour": {
      "type": "integer",
      "minimum": 0
    },
    "stage_bonus_percent": {
      "type": "integer",
      "minimum": 0
    },
    "quick_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "quick_daily_limit": {
      "type": "integer",
      "minimum": 0
    },
    "crystals_per_hour": {
      "type": "integer",
      "minimum": 0
    },
    "essence_per_hour": {
      "type": "integer",
      "minimum": 0
    },
    "ore_per_hour": {
      "type": "integer",
      "minimum": 0,
      "description": "Руда в AFK-сундуке за час"
    },
    "equipment_per_100h": {
      "type": "integer",
      "minimum": 0,
      "description": "Предметов снаряжения за 100 часов AFK (50 = 1 предмет в 2 часа)"
    }
  }
}
