{
  "description": "Разделы админки. objects — как в разделе устроены объекты для ZIP-патчей и списков: file_per_object (каждый объект — свой файл, id из пути), array_in_file (массив в одном файле, id — поле id), single (один объект на весь файл). files — маски JSON-файлов раздела, assets — маски картинок/звуков. preview — какой предпросмотр показывать в админке.",
  "sections": [
    {"id": "settings", "title": "Настройки игры", "icon": "settings",
     "objects": {"kind": "single", "file": "config/game_settings.json", "id": "game_settings"},
     "files": ["config/game_settings.json"], "assets": ["ui/logo.png", "ui/loading_bg.png", "ui/button.png", "fonts/**"], "preview": "ui"},
    {"id": "hub", "title": "Главный экран", "icon": "city",
     "objects": {"kind": "single", "file": "ui/hub.json", "id": "hub"},
     "files": ["ui/hub.json"], "assets": ["ui/hub/**", "ui/items/**"], "preview": "hub"},
    {"id": "localization", "title": "Тексты", "icon": "quests",
     "objects": {"kind": "file_per_object", "path": "localization/{id}.json"},
     "files": ["localization/*.json"], "assets": [], "preview": "ui"},
    {"id": "heroes", "title": "Герои", "icon": "heroes",
     "objects": {"kind": "file_per_object", "path": "heroes/{id}/hero.json", "dir": "heroes/{id}/"},
     "files": ["heroes/*/hero.json", "heroes/*/skeleton.json"], "assets": ["heroes/**"], "preview": "hero"},
    {"id": "factions", "title": "Фракции", "icon": "guild",
     "objects": {"kind": "array_in_file", "file": "factions/factions.json", "key": "factions"},
     "files": ["factions/factions.json"], "assets": ["factions/**"], "preview": "none"},
    {"id": "battle", "title": "Бой и отряды", "icon": "power",
     "objects": {"kind": "array_in_file", "file": "battle/test_teams.json", "key": "teams"},
     "files": ["config/battle.json", "battle/*teams.json"], "assets": ["battle/**"], "preview": "none"},
    {"id": "campaign", "title": "Кампания и AFK", "icon": "world",
     "objects": {"kind": "file_per_object", "path": "campaign/{id}/chapter.json", "dir": "campaign/{id}/"},
     "files": ["config/campaign.json", "campaign/*/chapter.json"], "assets": ["campaign/**"], "preview": "campaign"},
    {"id": "progression", "title": "Прогрессия героев", "icon": "stronger",
     "objects": {"kind": "single", "file": "config/progression.json", "id": "progression"},
     "files": ["config/progression.json"], "assets": [], "preview": "none"},
    {"id": "equipment", "title": "Снаряжение", "icon": "inventory",
     "objects": {"kind": "single", "file": "config/equipment.json", "id": "equipment"},
     "files": ["config/equipment.json"], "assets": ["ui/items/**"], "preview": "none"},
    {"id": "summon", "title": "Призыв", "icon": "summon",
     "objects": {"kind": "array_in_file", "file": "summon/banners.json", "key": "banners"},
     "files": ["summon/banners.json"], "assets": ["summon/**"], "preview": "none"},
    {"id": "tutorial", "title": "Обучение", "icon": "tasks",
     "objects": {"kind": "single", "file": "tutorial/tutorial.json", "id": "tutorial"},
     "files": ["tutorial/**/*.json"], "assets": ["tutorial/**"], "preview": "none"},
    {"id": "packages", "title": "Пакеты загрузки", "icon": "bag",
     "objects": {"kind": "single", "file": "packages.json", "id": "packages"},
     "files": ["packages.json"], "assets": [], "preview": "none"}
  ]
}
