# =====================================================================
# Пример настроек сервера. На VPS скопируйте в .env и заполните:
#   cp .env.example .env && nano .env
# Файл .env НЕ попадает в git (он в .gitignore).
# =====================================================================

# Имя проекта Docker Compose — префикс всех контейнеров/томов.
# Не меняйте после первого запуска (иначе Docker создаст новые пустые тома).
COMPOSE_PROJECT_NAME=ufagame

# Порт на VPS, на котором Nginx игры принимает HTTP.
HTTP_PORT=8085
# На каком адресе слушать порт:
#   127.0.0.1 — только локально; снаружи игра доступна через ваш основной
#               веб-сервер по https://DOMAIN/PUBLIC_PATH_PREFIX (рекомендуется)
#   0.0.0.0   — открыть порт напрямую в интернет (без HTTPS, только для отладки)
HTTP_BIND=127.0.0.1

# Публичный адрес сервера игры
DOMAIN=tts-ufa.ru
# Путь на домене, под которым работает сервер (без / в конце).
# Пусто — если сервер на корне домена.
PUBLIC_PATH_PREFIX=/games/server

# --- База данных PostgreSQL (наружу не открывается) ---
POSTGRES_DB=ufagame
POSTGRES_USER=ufagame
# Сгенерировать пароль: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# --- Секрет для подписи токенов (сгенерировать: openssl rand -hex 32) ---
SECRET_KEY=CHANGE_ME

# --- Обновления приложения ---
# Токен, с которым GitHub Actions загружает новые APK на сервер.
# Сгенерировать: openssl rand -hex 32 ; это же значение — в секрет GitHub CLIENT_UPLOAD_TOKEN
CLIENT_UPLOAD_TOKEN=

# --- Бэкапы ---
# Час по UTC (0-23), когда делать ежедневный бэкап.
# Уфа = UTC+5, поэтому 0 = 05:00 по Уфе.
BACKUP_HOUR=0
# Сколько дней хранить бэкапы
BACKUP_RETENTION_DAYS=14
# Папка на VPS для бэкапов (относительно папки проекта или абсолютный путь)
BACKUP_DIR=./backups

# Уровень логов: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
